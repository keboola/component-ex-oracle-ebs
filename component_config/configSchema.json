{
  "type": "object",
  "title": "Oracle EBS Extractor — Connection Settings",
  "properties": {
    "connection": {
      "type": "object",
      "title": "Connection Settings",
      "format": "grid-strict",
      "propertyOrder": 1,
      "required": ["db_host", "db_service_name", "db_user", "#db_password"],
      "properties": {
        "db_host": {
          "type": "string",
          "title": "Database Host",
          "description": "Hostname or IP address of the Oracle database server",
          "propertyOrder": 1,
          "options": {
            "grid_columns": 8
          }
        },
        "db_port": {
          "type": "integer",
          "title": "Port",
          "default": 1521,
          "propertyOrder": 2,
          "options": {
            "grid_columns": 2
          }
        },
        "test_connection": {
          "type": "button",
          "format": "test-connection",
          "propertyOrder": 3,
          "options": {
            "grid_columns": 2
          }
        },
        "db_service_name": {
          "type": "string",
          "title": "Service Name",
          "description": "Oracle service name (e.g. ebs_EBSDB)",
          "propertyOrder": 4,
          "options": {
            "grid_columns": 12
          }
        },
        "db_user": {
          "type": "string",
          "title": "Username",
          "propertyOrder": 5,
          "options": {
            "grid_columns": 6
          }
        },
        "#db_password": {
          "type": "string",
          "title": "Password",
          "format": "password",
          "propertyOrder": 6,
          "options": {
            "grid_columns": 6
          }
        }
      }
    },
    "ssh_options": {
      "type": "object",
      "title": "SSH Tunnel",
      "format": "grid-strict",
      "propertyOrder": 2,
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enable SSH Tunnel",
          "description": "Tunnel the database connection through an SSH bastion host.",
          "format": "checkbox",
          "default": false,
          "propertyOrder": 1,
          "options": {
            "grid_columns": 12
          }
        },
        "sshHost": {
          "type": "string",
          "title": "SSH Host",
          "description": "Bastion / jump host hostname",
          "propertyOrder": 2,
          "options": {
            "grid_columns": 4,
            "dependencies": {
              "ssh_options.enabled": true
            }
          }
        },
        "sshPort": {
          "type": "integer",
          "title": "SSH Port",
          "default": 22,
          "propertyOrder": 3,
          "options": {
            "grid_columns": 4,
            "dependencies": {
              "ssh_options.enabled": true
            }
          }
        },
        "user": {
          "type": "string",
          "title": "SSH Username",
          "propertyOrder": 4,
          "options": {
            "grid_columns": 4,
            "dependencies": {
              "ssh_options.enabled": true
            }
          }
        },
        "keys": {
          "type": "object",
          "title": "SSH Keys",
          "propertyOrder": 5,
          "format": "grid-strict",
          "options": {
            "grid_columns": 12,
            "dependencies": {
              "ssh_options.enabled": true
            }
          },
          "properties": {
            "#private": {
              "type": "string",
              "title": "Private Key",
              "description": "Private SSH key in PEM format. Paste the full key including BEGIN/END lines.",
              "format": "textarea",
              "propertyOrder": 1,
              "options": {
                "grid_columns": 12,
                "input_height": "150px"
              }
            },
            "public": {
              "type": "string",
              "title": "Public Key",
              "description": "Optional — public key paired with the private key (informational).",
              "propertyOrder": 2,
              "options": {
                "grid_columns": 12
              }
            }
          }
        }
      }
    }
  }
}
