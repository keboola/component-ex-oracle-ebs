{
  "type": "object",
  "title": "Extraction Row",
  "required": ["source", "destination"],
  "properties": {
    "source": {
      "type": "object",
      "title": "Source",
      "format": "collapse",
      "propertyOrder": 1,
      "properties": {
        "extraction_mode": {
          "type": "string",
          "title": "Extraction Mode",
          "enum": ["Preset", "Custom"],
          "default": "Preset",
          "propertyOrder": 1
        },
        "module": {
          "type": "string",
          "title": "EBS Module",
          "enum": ["ap", "ar", "gl", "po", "inv", "hr", "om", "tca"],
          "options": {
            "enum_titles": [
              "Accounts Payable (AP)",
              "Accounts Receivable (AR)",
              "General Ledger (GL)",
              "Purchasing (PO)",
              "Inventory (INV)",
              "Human Resources (HR)",
              "Order Management (OM)",
              "Trading Community (TCA)"
            ],
            "dependencies": {
              "source.extraction_mode": "Preset"
            }
          },
          "propertyOrder": 2
        },
        "entity": {
          "type": "string",
          "title": "Entity",
          "format": "select",
          "enum": [],
          "propertyOrder": 3,
          "options": {
            "async": {
              "label": "Load Entities",
              "action": "listEntities"
            },
            "dependencies": {
              "source.extraction_mode": "Preset"
            }
          }
        },
        "org_id": {
          "type": "string",
          "title": "Operating Unit (Org ID)",
          "format": "select",
          "enum": [],
          "propertyOrder": 4,
          "options": {
            "async": {
              "label": "Load Operating Units",
              "action": "listOperatingUnits"
            },
            "dependencies": {
              "source.extraction_mode": "Preset"
            }
          }
        },
        "ledger_id": {
          "type": "string",
          "title": "Ledger",
          "format": "select",
          "enum": [],
          "propertyOrder": 5,
          "options": {
            "async": {
              "label": "Load Ledgers",
              "action": "listLedgers"
            },
            "dependencies": {
              "source.extraction_mode": "Preset",
              "source.module": "gl"
            }
          }
        },
        "custom_query": {
          "type": "string",
          "title": "Custom SQL Query",
          "description": "Write a SQL SELECT query. Use apps. schema prefix for EBS tables.",
          "format": "textarea",
          "propertyOrder": 6,
          "options": {
            "dependencies": {
              "source.extraction_mode": "Custom"
            }
          }
        }
      }
    },
    "destination": {
      "type": "object",
      "title": "Destination",
      "format": "collapse",
      "required": ["output_table"],
      "propertyOrder": 2,
      "properties": {
        "output_table": {
          "type": "string",
          "title": "Output Table Name",
          "propertyOrder": 1
        },
        "incremental": {
          "type": "boolean",
          "title": "Incremental Loading",
          "description": "When enabled, only rows updated since the last run are extracted (uses LAST_UPDATE_DATE).",
          "default": false,
          "propertyOrder": 2
        },
        "primary_key": {
          "type": "array",
          "title": "Primary Key Columns",
          "description": "Leave empty to use the preset default.",
          "format": "select",
          "items": {
            "type": "string",
            "enum": []
          },
          "uniqueItems": true,
          "propertyOrder": 3,
          "options": {
            "tags": true
          }
        }
      }
    }
  }
}
