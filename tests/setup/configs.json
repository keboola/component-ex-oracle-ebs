          "#db_password": "PLACEHOLDER"
        },
        "source": {
          "extraction_mode": "Custom",
          "custom_query": "SELECT code_combination_id, chart_of_accounts_id, segment1, segment2, segment3, account_type, enabled_flag FROM apps.gl_code_combinations WHERE enabled_flag = 'Y' AND ROWNUM <= 50"
        },
        "destination": {
          "output_table": "ebs_gl_code_combinations",
          "incremental": false,
          "primary_key": ["CODE_COMBINATION_ID"]
        }
      }
    }
