  {
    "name": "10_run_custom_po_headers_limited",
    "description": "Custom: PO Headers with vendor JOIN, limited to 50 rows",
    "config": {
      "action": "run",
      "parameters": {
        "connection": {
          "db_host": "PLACEHOLDER",
          "db_port": 1521,
          "db_service_name": "PLACEHOLDER",
          "db_user": "PLACEHOLDER",
          "#db_password": "PLACEHOLDER"
        },
        "source": {
          "extraction_mode": "Custom",
          "custom_query": "SELECT ph.po_header_id, ph.segment1 AS po_number, ph.type_lookup_code, ph.authorization_status, s.vendor_name, ph.currency_code, ph.org_id FROM apps.po_headers_all ph LEFT JOIN apps.po_vendors s ON ph.vendor_id = s.vendor_id WHERE ph.org_id = 204 AND ROWNUM <= 50"
        },
        "destination": {
          "output_table": "ebs_po_headers",
          "incremental": false,
          "primary_key": ["PO_HEADER_ID"]
        }
      }
    }
  },
  {
    "name": "11_run_custom_ar_invoices_limited",
    "description": "Custom: AR Invoices with customer JOIN, limited to 50 rows",
    "config": {
      "action": "run",
      "parameters": {
        "connection": {
          "db_host": "PLACEHOLDER",
          "db_port": 1521,
          "db_service_name": "PLACEHOLDER",
          "db_user": "PLACEHOLDER",
          "#db_password": "PLACEHOLDER"
        },
        "source": {
          "extraction_mode": "Custom",
          "custom_query": "SELECT ct.customer_trx_id, ct.trx_number, ct.trx_date, hp.party_name AS customer_name, ct.invoice_currency_code, ct.org_id FROM apps.ra_customer_trx_all ct LEFT JOIN apps.hz_cust_accounts ca ON ct.bill_to_customer_id = ca.cust_account_id LEFT JOIN apps.hz_parties hp ON ca.party_id = hp.party_id WHERE ct.org_id = 204 AND ROWNUM <= 50"
        },
        "destination": {
          "output_table": "ebs_ar_invoices",
          "incremental": false,
          "primary_key": ["CUSTOMER_TRX_ID"]
        }
      }
    }
  },
  {
    "name": "12_run_custom_query_with_join",
    "description": "Custom: AP invoices with supplier names, limited to 20 rows",
    "config": {
      "action": "run",
      "parameters": {
        "connection": {
          "db_host": "PLACEHOLDER",
          "db_port": 1521,
          "db_service_name": "PLACEHOLDER",
          "db_user": "PLACEHOLDER",
          "#db_password": "PLACEHOLDER"
        },
        "source": {
          "extraction_mode": "Custom",
          "custom_query": "SELECT i.invoice_id, i.invoice_num, i.invoice_amount, s.vendor_name FROM apps.ap_invoices_all i LEFT JOIN apps.ap_suppliers s ON i.vendor_id = s.vendor_id WHERE i.org_id = 204 AND ROWNUM <= 20"
        },
        "destination": {
          "output_table": "ebs_custom_ap_with_vendor",
          "incremental": false,
          "primary_key": ["INVOICE_ID"]
        }
      }
    }
  },
