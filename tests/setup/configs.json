  {
    "name": "07_run_custom_query",
    "description": "Custom: select 10 users from fnd_user",
    "config": {
      "action": "run",
      "parameters": {
        "connection": {
          "db_host": "PLACEHOLDER",
          "db_port": 1521,
          "db_service_name": "PLACEHOLDER",
          "db_user": "PLACEHOLDER",
          "#db_password": "PLACEHOLDER"
        },
        "source": {
          "extraction_mode": "Custom",
          "custom_query": "SELECT user_id, user_name, email_address, creation_date FROM apps.fnd_user WHERE ROWNUM <= 10 ORDER BY user_id"
        },
        "destination": {
          "output_table": "ebs_fnd_users_sample",
          "incremental": false,
          "primary_key": ["USER_ID"]
        }
      }
    }
  },
  {
    "name": "08_run_custom_gl_code_combinations",
    "description": "Custom: GL Code Combinations limited to 50 rows",
    "config": {
      "action": "run",
      "parameters": {
        "connection": {
